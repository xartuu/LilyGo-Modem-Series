<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <system.serviceModel>
      <client>
        <endpoint address = "http://192.168.10.16:8090/WebService/BasalWebservice.asmx"
            binding="basicHttpBinding" bindingConfiguration="BasalWebServiceSoap"
            contract="BasalWebservice.BasalWebServiceSoap" name="BasalWebServiceSoap" />
        <endpoint address = "http://192.168.10.16:8090/WebService/MESATEApi.asmx"
            binding="basicHttpBinding" bindingConfiguration="MesATEApiSoap"
            contract="MESATEApi.MesATEApiSoap" name="MesATEApiSoap" />
        <endpoint address = "http://192.168.10.16:8090/webservice/mesapi.asmx"
            binding="basicHttpBinding" bindingConfiguration="MESAPISoap"
            contract="mesapi.MESAPISoap" name="MESAPISoap" />
      </client>
        <bindings>
            <basicHttpBinding>
                <binding name="MESAPISoap" />
                <binding name="MesATEApiSoap" />
                <binding name="BasalWebServiceSoap" />
            </basicHttpBinding>
            <customBinding>
                <binding name="MESAPISoap12">
                    <textMessageEncoding messageVersion="Soap12" />
                    <httpTransport />
                </binding>
                <binding name="MesATEApiSoap12">
                    <textMessageEncoding messageVersion="Soap12" />
                    <httpTransport />
                </binding>
                <binding name="BasalWebServiceSoap12">
                    <textMessageEncoding messageVersion="Soap12" />
                    <httpTransport />
                </binding>
            </customBinding>
        </bindings>
    </system.serviceModel>
</configuration>